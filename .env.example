# ──────────────────────────────────────
# BioExtractor Environment Configuration
# ──────────────────────────────────────

# Google Gemini API Key (optional for server-wide fallback; users can also provide via UI)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Gemini model to use (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Application server settings
APP_PORT=5000
DEBUG_MODE=true
